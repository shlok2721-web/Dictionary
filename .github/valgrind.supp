# Valgrind suppressions for third-party leaks seen in the 30-minute soak runs.
#
# Everything here is allocated inside GTK / libadwaita / Pango / fontconfig /
# librsvg and is either a process-lifetime singleton (GtkSettings, icon theme,
# font caches) or a known library leak. None of it comes from this project's
# code, and none of it grows while the app runs. Project leaks must never be
# suppressed here.

{
   gtk-adw-startup-singletons
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible
   fun:malloc
   ...
   fun:gtk_settings_get_for_display
}
{
   gtk-icon-theme-singleton
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible
   fun:*alloc
   ...
   fun:gtk_icon_theme_get_for_display
}
{
   fontconfig-init
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible
   fun:*alloc
   ...
   fun:FcInit
}
{
   fontconfig-render-prepare
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible
   fun:*alloc
   ...
   fun:FcFontRenderPrepare
}
{
   fontconfig-value-save
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible
   fun:*alloc
   ...
   fun:FcValueSave
}
{
   pango-layout-measure-fontconfig
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible
   fun:*alloc
   ...
   obj:*/libfontconfig.so*
   ...
   fun:pango_layout_get_size
}
{
   librsvg-handle-new
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible
   fun:*alloc
   ...
   fun:rsvg_handle_new_from_stream_sync
}
