<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.5"/>
  <template class="SettingsDialog" parent="AdwPreferencesDialog">
    <property name="title" translatable="yes">Preferences</property>
    <child>
      <object class="AdwPreferencesPage">
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">General</property>
            <child>
              <object class="AdwSwitchRow" id="dark_ui_switch">
                <property name="title" translatable="yes">Dark Mode</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="double_click_switch">
                <property name="title" translatable="yes">Search on Double Click</property>
                <property name="subtitle" translatable="yes">Double-click a word in a definition to look it up</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="live_search_switch">
                <property name="title" translatable="yes">Live Search</property>
                <property name="subtitle" translatable="yes">Search while typing</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="auto_paste_switch">
                <property name="title" translatable="yes">Auto-Paste on Launch</property>
                <property name="subtitle" translatable="yes">Search the clipboard text when the app starts</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Pronunciation</property>
            <child>
              <object class="AdwComboRow" id="pronunciations_accent_row">
                <property name="title" translatable="yes">Accent</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item translatable="yes">American English</item>
                      <item translatable="yes">British English</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="voice_style_row">
                <property name="title" translatable="yes">Voice</property>
                <property name="subtitle" translatable="yes">espeak-ng's own default voice is flat and monotone</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item translatable="yes">Female</item>
                      <item translatable="yes">Female (Soft)</item>
                      <item translatable="yes">Male</item>
                      <item translatable="yes">Default (Flat)</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="voice_pitch_row">
                <property name="title" translatable="yes">Pitch</property>
                <property name="subtitle" translatable="yes">50 is the voice's own unchanged pitch</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">0</property>
                    <property name="upper">99</property>
                    <property name="step-increment">1</property>
                    <property name="page-increment">10</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="use_recorded_audio_switch">
                <property name="title" translatable="yes">Prefer Recorded Pronunciations</property>
                <property name="subtitle" translatable="yes">When available, play a human recording instead of synthesized speech. Downloads and caches recordings on first use — the only setting that makes Dictionary use the network</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Tray &amp; Background</property>
            <property name="description" translatable="yes">Requires an SNI-compatible tray host, such as waybar's tray module</property>
            <child>
              <object class="AdwSwitchRow" id="tray_enabled_switch">
                <property name="title" translatable="yes">Show Tray Icon</property>
                <property name="subtitle" translatable="yes">Takes effect the next time Dictionary starts</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="run_in_background_switch">
                <property name="title" translatable="yes">Keep Running in Background</property>
                <property name="subtitle" translatable="yes">Don't quit when the window is closed; reopen it from the tray icon</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="clipboard_watch_switch">
                <property name="title" translatable="yes">Automatic Word Lookup</property>
                <property name="subtitle" translatable="yes">Look up a one- or two-word copy or selection as soon as it happens, anywhere on the system</property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="lookup_source_row">
                <property name="title" translatable="yes">Lookup Trigger</property>
                <property name="subtitle" translatable="yes">Selecting only needs you to highlight the text; no Ctrl+C</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item translatable="yes">Copied text</item>
                      <item translatable="yes">Selected (highlighted) text</item>
                      <item translatable="yes">Copied or selected text</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="auto_show_popup_switch">
                <property name="title" translatable="yes">Auto-Show Mini Window</property>
                <property name="subtitle" translatable="yes">Otherwise, click the tray icon to see the last copied word</property>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="popup_size_row">
                <property name="title" translatable="yes">Mini Window Size</property>
                <property name="subtitle" translatable="yes">Percent of your monitor's width</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">10</property>
                    <property name="upper">50</property>
                    <property name="step-increment">5</property>
                    <property name="page-increment">10</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="popup_autohide_row">
                <property name="title" translatable="yes">Mini Window Auto-Hide</property>
                <property name="subtitle" translatable="yes">Seconds before the popup closes on its own; touching it resets the countdown</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">1</property>
                    <property name="upper">60</property>
                    <property name="step-increment">1</property>
                    <property name="page-increment">5</property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Database</property>
            <property name="description" translatable="yes">Takes effect the next time Dictionary starts</property>
            <child>
              <object class="AdwActionRow" id="database_row">
                <property name="title" translatable="yes">Database File</property>
                <property name="use-markup">False</property>
                <property name="subtitle-selectable">True</property>
                <child type="suffix">
                  <object class="GtkButton" id="database_reset_button">
                    <property name="icon-name">edit-clear-symbolic</property>
                    <property name="valign">center</property>
                    <property name="tooltip-text" translatable="yes">Use the default location</property>
                    <accessibility>
                      <property name="label" translatable="yes">Use the default database location</property>
                    </accessibility>
                    <style>
                      <class name="flat"/>
                    </style>
                  </object>
                </child>
                <child type="suffix">
                  <object class="GtkButton" id="database_choose_button">
                    <property name="label" translatable="yes">Choose…</property>
                    <property name="valign">center</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
